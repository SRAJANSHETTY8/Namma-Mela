<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="100dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Your Seats"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:id="@+id/dramaTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Vyali Nataka"
                android:textColor="#D4A843"
                android:textSize="16sp"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"/>

            <!-- Screen Indicator -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="8dp"
                app:cardBackgroundColor="#2A2A2A"
                app:cardElevation="0dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:text="STAGE / SCREEN"
                    android:textColor="#888888"
                    android:textSize="12sp"
                    android:gravity="center"
                    android:letterSpacing="0.2"/>
            </androidx.cardview.widget.CardView>

            <!-- Legend -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="20dp"
                android:gravity="center">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#4CAF50"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginEnd="16dp">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#D4A843"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:background="#C41E3A"
                        android:layout_marginEnd="6dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Booked"
                        android:textColor="#AAAAAA"
                        android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Seat Grid -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardElevation="4dp">

                <GridLayout
                    android:id="@+id/seatGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp"
                    android:columnCount="5"
                    android:rowCount="6"
                    android:alignmentMode="alignMargins"
                    android:useDefaultMargins="true">

                    <!-- Row A -->
                    <Button
                        android:id="@+id/A1"
                        style="@style/SeatButton"
                        android:text="A1"/>

                    <Button
                        android:id="@+id/A2"
                        style="@style/SeatButton"
                        android:text="A2"/>

                    <Button
                        android:id="@+id/A3"
                        style="@style/SeatButton"
                        android:text="A3"/>

                    <Button
                        android:id="@+id/A4"
                        style="@style/SeatButton"
                        android:text="A4"/>

                    <Button
                        android:id="@+id/A5"
                        style="@style/SeatButton"
                        android:text="A5"/>

                    <!-- Row B -->
                    <Button
                        android:id="@+id/B1"
                        style="@style/SeatButton"
                        android:text="B1"/>

                    <Button
                        android:id="@+id/B2"
                        style="@style/SeatButton"
                        android:text="B2"/>

                    <Button
                        android:id="@+id/B3"
                        style="@style/SeatButton"
                        android:text="B3"/>

                    <Button
                        android:id="@+id/B4"
                        style="@style/SeatButton"
                        android:text="B4"/>

                    <Button
                        android:id="@+id/B5"
                        style="@style/SeatButton"
                        android:text="B5"/>

                    <!-- Row C -->
                    <Button
                        android:id="@+id/C1"
                        style="@style/SeatButton"
                        android:text="C1"/>

                    <Button
                        android:id="@+id/C2"
                        style="@style/SeatButton"
                        android:text="C2"/>

                    <Button
                        android:id="@+id/C3"
                        style="@style/SeatButton"
                        android:text="C3"/>

                    <Button
                        android:id="@+id/C4"
                        style="@style/SeatButton"
                        android:text="C4"/>

                    <Button
                        android:id="@+id/C5"
                        style="@style/SeatButton"
                        android:text="C5"/>

                    <!-- Row D -->
                    <Button
                        android:id="@+id/D1"
                        style="@style/SeatButton"
                        android:text="D1"/>

                    <Button
                        android:id="@+id/D2"
                        style="@style/SeatButton"
                        android:text="D2"/>

                    <Button
                        android:id="@+id/D3"
                        style="@style/SeatButton"
                        android:text="D3"/>

                    <Button
                        android:id="@+id/D4"
                        style="@style/SeatButton"
                        android:text="D4"/>

                    <Button
                        android:id="@+id/D5"
                        style="@style/SeatButton"
                        android:text="D5"/>

                    <!-- Row E -->
                    <Button
                        android:id="@+id/E1"
                        style="@style/SeatButton"
                        android:text="E1"/>

                    <Button
                        android:id="@+id/E2"
                        style="@style/SeatButton"
                        android:text="E2"/>

                    <Button
                        android:id="@+id/E3"
                        style="@style/SeatButton"
                        android:text="E3"/>

                    <Button
                        android:id="@+id/E4"
                        style="@style/SeatButton"
                        android:text="E4"/>

                    <Button
                        android:id="@+id/E5"
                        style="@style/SeatButton"
                        android:text="E5"/>

                    <!-- Row F -->
                    <Button
                        android:id="@+id/F1"
                        style="@style/SeatButton"
                        android:text="F1"/>

                    <Button
                        android:id="@+id/F2"
                        style="@style/SeatButton"
                        android:text="F2"/>

                    <Button
                        android:id="@+id/F3"
                        style="@style/SeatButton"
                        android:text="F3"/>

                    <Button
                        android:id="@+id/F4"
                        style="@style/SeatButton"
                        android:text="F4"/>

                    <Button
                        android:id="@+id/F5"
                        style="@style/SeatButton"
                        android:text="F5"/>

                </GridLayout>
            </androidx.cardview.widget.CardView>

            <!-- Selected Seats Info -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Seats"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/selectedSeatsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="None"
                        android:textColor="#D4A843"
                        android:textSize="14sp"
                        android:layout_marginTop="8dp"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#2A2A2A"
                        android:layout_marginVertical="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Total Amount"
                            android:textColor="#888888"
                            android:textSize="14sp"/>

                        <TextView
                            android:id="@+id/totalAmountText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="₹0"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Confirm Button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#161616"
        android:padding="16dp"
        android:elevation="16dp">

        <Button
            android:id="@+id/confirmBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Confirm Booking"
            android:textStyle="bold"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:background="@drawable/bg_button_gold"
            android:fontFamily="sans-serif-medium"/>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>