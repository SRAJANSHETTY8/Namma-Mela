<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fan Wall"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Share your thoughts with the community"
                android:textColor="#888888"
                android:textSize="14sp"
                android:layout_marginTop="4dp"/>

            <!-- Post Comment Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="#1A1A1A"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Write a Review"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"/>

                    <!-- Name Input -->
                    <EditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:background="@drawable/bg_input_dark"
                        android:hint="Your Name"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:inputType="textPersonName"/>

                    <!-- Email Input -->
                    <EditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input_dark"
                        android:hint="Your Email"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:paddingHorizontal="16dp"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:inputType="textEmailAddress"/>

                    <!-- Comment Input -->
                    <EditText
                        android:id="@+id/commentInput"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_input_dark"
                        android:hint="Leave your applause..."
                        android:textColor="#FFFFFF"
                        android:textColorHint="#666666"
                        android:paddingHorizontal="16dp"
                        android:paddingVertical="12dp"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:gravity="top"
                        android:inputType="textMultiLine"/>

                    <!-- Post Button -->
                    <Button
                        android:id="@+id/postBtn"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Post Applause"
                        android:textStyle="bold"
                        android:textColor="#1A1A1A"
                        android:textSize="15sp"
                        android:background="@drawable/bg_button_gold"
                        android:fontFamily="sans-serif-medium"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Comments Section Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Recent Applause"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/commentCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 applause"
                    android:textColor="#888888"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- Comments RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/commentsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:nestedScrollingEnabled="false"/>

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyCommentCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="40dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👏"
                    android:textSize="40sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No applause yet"
                    android:textColor="#888888"
                    android:textSize="16sp"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Be the first to share your experience!"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Hidden old comment box (for backward compatibility) -->
            <TextView
                android:id="@+id/commentBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audience comments appear here..."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:padding="16dp"
                android:background="#1A1A1A"
                android:layout_marginTop="24dp"
                android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>